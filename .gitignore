# Dependencies
node_modules/

# Local scratch (never committed)
scratch/
scratch-*
*.log
probe.cjs

# Build output IS committed on purpose: the dsh runtime loads lib/index.js and
# lib/client.js directly, so `dsh plugin add <git-url>` installs a working
# plugin without needing a build toolchain. `build/` is NOT ignored here: it
# holds tsdown.client.ts, the build helper that tsdown.config.ts imports, so
# ignoring it would make a fresh clone fail to build.

